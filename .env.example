# ================================================================
# MOBI-NURSE — environment variables
# Local: copy to .env.local   |   Vercel: Project → Settings → Environment Variables
# ================================================================

# Public URL of the deployed site (no trailing slash), e.g. https://mobinurse.vercel.app
APP_BASE_URL=http://localhost:3000

# Supabase (Project Settings → API Keys). The SECRET key is server-only: never put it in the Android app.
SUPABASE_URL=https://ldjbdrpbrdsnfqkgauwj.supabase.co
SUPABASE_SECRET_KEY=

# Session signing key (random, at least 32 chars). Generate: openssl rand -base64 48
JWT_SECRET=

# First admin account (created automatically on the first admin login, must change password).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Kashier (Dashboard → Integrate → API Keys). MODE: test | live
KASHIER_MERCHANT_ID=
KASHIER_API_KEY=
KASHIER_MODE=test

# Optional — push notifications (Firebase project → Service accounts → Generate key → base64 of the JSON file)
FCM_SERVICE_ACCOUNT_BASE64=

# Optional — public link to download the Android APK (shown on the home page)
NEXT_PUBLIC_ANDROID_APK_URL=
